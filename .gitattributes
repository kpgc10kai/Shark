* text=auto

# Source and docs: keep LF in the repository and working tree.
*.c text eol=lf
*.h text eol=lf
*.inc text eol=lf
*.rs text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.pro text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
gradlew text eol=lf

# Windows launchers.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts must never be normalized.
*.so binary
*.apk binary
*.aar binary
*.jar binary
*.img binary
*.bin binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
